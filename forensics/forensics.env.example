# UNIT3D forensics & recovery bench — configuration.
#
# Copy to  forensics/forensics.env  and adjust for your stack. Every value has a
# sane default matching a standard UNIT3D_Docker layout, so on a vanilla install
# you can run the bench without editing anything. All paths are RELATIVE to the
# UNIT3D project root (the directory holding docker-compose.yml).
#
# The lab-*.sh scripts source this file and export it, so the same values drive
# both the scripts and docker-compose variable substitution.

# --- toolbox image (published to Docker Hub; pinned tag avoids :latest clobber) ---
FORENSICS_IMAGE=rawsmoke/unit3d-forensics:v0.1.0

# --- compose project + container names (kept separate from the prod stack) ---
FORENSICS_PROJECT=unit3d_forensics
LAB_DB_CONTAINER=unit3d-lab-db
FX_CONTAINER=unit3d-forensics

# --- prod stack handles (read-only sources) ---
PROD_DB_CONTAINER=unit3d-db
PROD_DB_USER=backupbot          # read-only backup account; never DDL/DML
DB_NAME=unit3d

# --- lab MySQL (isolated, air-gapped, local-only) ---
LAB_DB_IMAGE=mysql/mysql-server:8.0   # match your prod server image/version
LAB_DB_PASSWORD=labforensics          # local lab only; never exposed off-box

# --- read-only source paths (relative to project root) ---
PROD_MYSQL_DIR=./.docker/data/mysql                 # holds the prod binlogs
BACKUPS_DIR=./backups                               # 4h dumps + snapshots
TORRENTS_DIR=./storage/app/files/torrents           # .torrent files
REDIS_DIR=./.docker/data/redis
MEILI_DIR=./.docker/data/meilisearch

# --- lab datadir (read-write, isolated from prod) ---
LAB_DATADIR=./.docker/data/mysql_lab
