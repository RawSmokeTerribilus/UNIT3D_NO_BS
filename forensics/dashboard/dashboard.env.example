# UNIT3D forensics lab dashboard — configuration.
# Copy to  forensics/dashboard/dashboard.env  and adjust. Defaults match a
# standard UNIT3D_Docker layout, so a vanilla install runs without editing.
#
# The systemd --user unit loads this via EnvironmentFile.

# --- bind (LOCAL-ONLY by default) ---
# 127.0.0.1 = reachable only from this host (rawserver is the daily desktop).
# To reach it over the Tailscale tailnet, set the box's tailnet IP instead,
# e.g. BIND_ADDR=100.78.183.6  (never 0.0.0.0 — that exposes it to every NIC).
BIND_ADDR=127.0.0.1
PORT=8780

# --- lab container names (must match forensics/forensics.env) ---
LAB_DB_CONTAINER=unit3d-lab-db
FX_CONTAINER=unit3d-forensics
