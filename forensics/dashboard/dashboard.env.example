# UNIT3D forensics lab dashboard — configuration.
# Copy to  forensics/dashboard/dashboard.env  and adjust. Defaults match a
# standard UNIT3D_Docker layout, so a vanilla install runs without editing.
#
# The systemd --user unit loads this via EnvironmentFile.

# --- bind (LOCAL-ONLY by default) ---
# 127.0.0.1 = reachable only from this host (rawserver is the daily desktop).
# To reach it over the Tailscale tailnet, set the box's tailnet IP instead,
# e.g. BIND_ADDR=100.78.183.6  (never 0.0.0.0 — that exposes it to every NIC).
BIND_ADDR=127.0.0.1
PORT=8780

# --- auth (fail-closed) -------------------------------------------------------
# This panel can DROP/restore PROD, so it never exposes itself without auth.
#
#   none      -> no login; ONLY allowed when BIND_ADDR is local (the default).
#                Binding a non-local address with AUTH_MODE=none REFUSES to start.
#   cf-access -> verify a Cloudflare Access JWT on every request and check the
#                authenticated email against ALLOWED_EMAILS. The OAuth/MFA login
#                happens at Cloudflare's edge; this only verifies it. See README
#                ("Autenticación y exposición segura").
AUTH_MODE=none
# For cf-access mode, set all three (front it with CF Tunnel + CF Access):
#   CF_ACCESS_TEAM=your-team            # your-team.cloudflareaccess.com
#   CF_ACCESS_AUD=                      # the Access application AUD tag
#   ALLOWED_EMAILS=owner@example.com    # comma-separated; one email = owner-only

# --- lab container names (must match forensics/forensics.env) ---
LAB_DB_CONTAINER=unit3d-lab-db
FX_CONTAINER=unit3d-forensics
