# Panel de consultas para auditorías — configuración.
#
# Copiar a  auditor/auditor.env  y ajustar. Todo tiene un valor por defecto que
# funciona en una instalación estándar de UNIT3D_Docker.

# --- servicio ---
AUDITOR_PROJECT=unit3d_auditor
AUDITOR_CONTAINER=unit3d-auditor
BIND_ADDR=127.0.0.1
PORT=8781

# --- MySQL de producción (por red, nunca docker exec) ---
# El host es el alias del contenedor de la base dentro de su propia red.
AUDITOR_DB_HOST=db
AUDITOR_DB_PORT=3306
AUDITOR_DB_NAME=unit3d
AUDITOR_DB_USER=auditro
# AUDITOR_DB_PASS se inyecta desde ~/Hardening/.env
# (UNIT3D_PROD_DB_AUDITRO_PASS). Nunca se escribe aquí.

# --- staging, opcional: probar una composición antes de lanzarla a prod ---
AUDITOR_STAGING_ENABLED=false
AUDITOR_STAGING_DB_HOST=db
AUDITOR_STAGING_DB_NAME=unit3d

# --- Loki y Prometheus (puertos INTERNOS, se llega por la red de monitoring) ---
AUDITOR_LOKI_URL=http://loki:3100
AUDITOR_PROM_URL=http://prometheus:9090
# Retención real de cada fuente, para avisar cuando se pide más atrás.
AUDITOR_LOKI_RETENTION_DAYS=7
AUDITOR_PROM_RETENTION_DAYS=15
AUDITOR_BINLOG_RETENTION_DAYS=30

# --- límites de ejecución ---
AUDITOR_MAX_ROWS=5000
AUDITOR_MAX_EXEC_MS=15000
AUDITOR_MAX_LINK_KEYS=10000
# El binlog no lo frena max_execution_time (eso es de MySQL): tope de reloj.
AUDITOR_BINLOG_MAX_SECONDS=45

# --- archivo de ejecuciones ---
AUDITOR_ARCHIVE_ROW_DAYS=365

# --- redes externas a las que se une el contenedor ---
AUDITOR_NET_PROD=unit3d_docker_unit3d
AUDITOR_NET_MONITORING=monitoring_docker_monitoring
AUDITOR_NET_STAGING=unit3d_develop_unit3d

# --- rutas de sólo lectura (relativas a la raíz del proyecto) ---
PROD_MYSQL_DIR=./.docker/data/mysql

# --- autenticación ---
# none = sólo válido con BIND_ADDR local. Con un bind no local y none, el
# servicio se niega a arrancar.
AUTH_MODE=none
ALLOWED_EMAILS=
CF_ACCESS_TEAM=
CF_ACCESS_AUD=
