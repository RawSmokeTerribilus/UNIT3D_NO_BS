diff -ruN a/lib/netplay/tcp/netsocket.cpp b/lib/netplay/tcp/netsocket.cpp
--- a/lib/netplay/tcp/netsocket.cpp	2026-10-23 16:15:12.790146480 +0200
+++ b/lib/netplay/tcp/netsocket.cpp	2026-10-23 16:37:59.297655802 +0200
@@ -31,6 +31,10 @@
 #include "lib/netplay/descriptor_set.h"
 
 #include <vector>
+#if defined(__EMSCRIPTEN__)
+# include <chrono>
+# include <thread>
+#endif
 
 #if defined(__clang__)
 	#pragma clang diagnostic ignored "-Wshorten-64-to-32" // FIXME!!
@@ -530,6 +534,25 @@
 
 #if   defined(WZ_OS_WIN)
 			ret = select(conn->fd[SOCK_CONNECTION] + 1, NULL, &conReady, &conFailed, &tv);
+#elif defined(__EMSCRIPTEN__)
+			// Arena NOBS: Emscripten's SOCKFS ignores the select() timeout (always 0), so poll until the
+			// WebSocket opens or the deadline passes. This runs on the async connection thread, so sleeping is fine.
+			{
+				const auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(timeout);
+				do
+				{
+					struct timeval zeroTv = {0, 0};
+					FD_ZERO(&conReady);
+					FD_SET(conn->fd[SOCK_CONNECTION], &conReady);
+					ret = select(conn->fd[SOCK_CONNECTION] + 1, nullptr, &conReady, nullptr, &zeroTv);
+					if (ret != 0)
+					{
+						break;
+					}
+					std::this_thread::sleep_for(std::chrono::milliseconds(20));
+				}
+				while (std::chrono::steady_clock::now() < deadline);
+			}
 #else
 			ret = select(conn->fd[SOCK_CONNECTION] + 1, nullptr, &conReady, nullptr, &tv);
 #endif
@@ -853,7 +876,7 @@
 #ifdef AI_V4MAPPED
 	flags             |= AI_V4MAPPED;
 #endif
-#ifdef AI_ADDRCONFIG
+#if defined(AI_ADDRCONFIG) && !defined(__EMSCRIPTEN__) // Arena NOBS: Emscripten's getaddrinfo returns EAI_NONAME for AI_ADDRCONFIG
 	flags             |= AI_ADDRCONFIG;
 #endif
 	hint.ai_flags     = flags;
diff -ruN a/platforms/emscripten/prejs.js b/platforms/emscripten/prejs.js
--- a/platforms/emscripten/prejs.js	2026-10-23 16:43:32.712085277 +0200
+++ b/platforms/emscripten/prejs.js	2026-10-23 16:43:32.717085359 +0200
@@ -0,0 +1,9 @@
+// Arena NOBS: Emscripten 4.0.10's JS getaddrinfo() calls assert() even in release builds, where it isn't
+// defined (STRICT, no ASSERTIONS). The ReferenceError leaves the proxied call hanging forever, so define it.
+if (typeof assert === 'undefined') {
+  var assert = function(condition, text) {
+    if (!condition) {
+      throw new Error('Assertion failed' + (text ? ': ' + text : ''));
+    }
+  };
+}
