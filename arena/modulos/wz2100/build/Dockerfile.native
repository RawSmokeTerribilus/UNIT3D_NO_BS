# Entorno de build del WZ2100 nativo (host headless), derivado de docker/ubuntu-24.04 del tag 4.7.0, sin Vulkan SDK.
# Contexto de build = árbol fuente de WZ (necesita get-dependencies_linux.sh y .ci/sdl3/install_sdl3.sh)
FROM ubuntu:24.04
RUN mkdir -p /scripts
COPY get-dependencies_linux.sh .ci/sdl3/install_sdl3.sh /scripts/
RUN chmod +x /scripts/*.sh \
 && apt-get -u update \
 && DEBIAN_FRONTEND=noninteractive apt-get -y install gcc g++ libc-dev dpkg-dev ninja-build pkg-config file wget \
 && /scripts/get-dependencies_linux.sh ubuntu build-dependencies \
 && cd /tmp && /scripts/install_sdl3.sh \
 && rm -rf /var/lib/apt/lists/*
