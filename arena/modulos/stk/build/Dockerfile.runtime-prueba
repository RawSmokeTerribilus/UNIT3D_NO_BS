FROM ubuntu:24.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends libcurl4t64 libssl3t64 libenet7 zlib1g python3 python3-venv ca-certificates \
 && python3 -m venv /opt/arena-venv && /opt/arena-venv/bin/pip install --no-cache-dir 'websockets==15.0.1' && rm -rf /var/lib/apt/lists/*
